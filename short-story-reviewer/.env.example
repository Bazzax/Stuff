# Set these in your shell or your host's environment settings. Never commit
# real values. (Locally: `set -a; source .env; set +a` after copying this to .env.)

# Required to run edits. Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: a shared code visitors must enter before they can use the app.
SSR_ACCESS_CODE=

# Optional limits (defaults in reviewer/config.py).
SSR_MAX_RUN_COST_USD=2.00
SSR_DAILY_SPEND_CAP_USD=20.00
SSR_RUNS_PER_HOUR_PER_IP=4

# Optional: a JSON file overriding models, effort and output caps per stage.
# SSR_CONFIG=config.json

# Optional: where the method files live (default: ./content).
# SSR_CONTENT_DIR=content
